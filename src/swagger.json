{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Matrículas",
    "version": "1.0.0",
    "description": "Documentação da API do Desafio Backend"
  },
  "servers": [
    {
      "url": "https://course-enrollment-api-px5r.onrender.com",
      "description": "Servidor de Produção (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/alunos": {
      "get": {
        "summary": "Lista todos os alunos",
        "tags": ["Alunos"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cria um novo aluno",
        "tags": ["Alunos"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "nome": { "type": "string" }, "email": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "Criado com sucesso" } }
      }
    },
    "/alunos/{id}": {
      "get": {
        "summary": "Busca um aluno por ID",
        "tags": ["Alunos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "put": {
        "summary": "Atualiza um aluno",
        "tags": ["Alunos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "nome": { "type": "string" }, "email": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Atualizado com sucesso" } }
      },
      "delete": {
        "summary": "Deleta um aluno",
        "tags": ["Alunos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Deletado com sucesso" } }
      }
    },
    "/cursos": {
      "get": {
        "summary": "Lista todos os cursos",
        "tags": ["Cursos"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cria um novo curso",
        "tags": ["Cursos"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "titulo": { "type": "string" }, "descricao": { "type": "string" } } } } }
        },
        "responses": { "201": { "description": "Criado com sucesso" } }
      }
    },
    "/cursos/{id}": {
      "get": {
        "summary": "Busca um curso por ID",
        "tags": ["Cursos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "put": {
        "summary": "Atualiza um curso",
        "tags": ["Cursos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "titulo": { "type": "string" }, "descricao": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Atualizado com sucesso" } }
      },
      "delete": {
        "summary": "Deleta um curso",
        "tags": ["Cursos"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Deletado com sucesso" } }
      }
    },
    "/matriculas": {
      "get": {
        "summary": "Lista todas as matrículas",
        "tags": ["Matrículas"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Matricula um aluno em um curso",
        "tags": ["Matrículas"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "alunoId": { "type": "integer" }, "cursoId": { "type": "integer" } } } } }
        },
        "responses": { "201": { "description": "Criado com sucesso" } }
      }
    },
    "/matriculas/{id}/concluir": {
      "patch": {
        "summary": "Conclui uma matrícula ativa",
        "tags": ["Matrículas"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Matrícula concluída" } }
      }
    },
    "/matriculas/{id}/cancelar": {
      "patch": {
        "summary": "Cancela uma matrícula",
        "tags": ["Matrículas"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Matrícula cancelada" } }
      }
    }
  }
}