{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Matrículas",
    "version": "1.0.0",
    "description": "Documentação da API do Desafio Backend"
  },
  "servers": [
    {
      "url": "https://course-enrollment-api-px5r.onrender.com",
      "description": "Servidor de Produção (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "paths": {
    "/alunos": {
      "get": {
        "summary": "Lista todos os alunos",
        "tags": ["Alunos"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cria um novo aluno",
        "tags": ["Alunos"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Bernardo Guerra" },
                  "email": { "type": "string", "example": "bernardo@email.com" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Criado com sucesso" }, "400": { "description": "Erro de validação" } }
      }
    },
    "/cursos": {
      "get": {
        "summary": "Lista todos os cursos",
        "tags": ["Cursos"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cria um novo curso",
        "tags": ["Cursos"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": { "type": "string", "example": "Backend com Node.js" },
                  "descricao": { "type": "string", "example": "Curso completo de criação de APIs" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Criado com sucesso" }, "400": { "description": "Erro de validação" } }
      }
    },
    "/matriculas": {
      "get": {
        "summary": "Lista todas as matrículas",
        "tags": ["Matrículas"],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Matricula um aluno em um curso",
        "tags": ["Matrículas"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alunoId": { "type": "integer", "example": 1 },
                  "cursoId": { "type": "integer", "example": 1 }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Criado com sucesso" }, "400": { "description": "Erro de validação ou regra de negócio" } }
      }
    },
    "/matriculas/{id}/concluir": {
      "patch": {
        "summary": "Conclui uma matrícula ativa",
        "tags": ["Matrículas"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID da matrícula"
          }
        ],
        "responses": { "200": { "description": "Matrícula concluída" }, "400": { "description": "Erro de status" } }
      }
    }
  }
}